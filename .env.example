# Hugging Face Token
HF_TOKEN=your_huggingface_token_here

# Kaggle Credentials (optional)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_key

# Colab Settings (optional)
# GOOGLE_DRIVE_MOUNT_PATH=/content/drive

# Application Settings
LOG_LEVEL=INFO
LOG_FORMAT=json
MAX_JOBS_PER_PROVIDER=5
DEFAULT_WORKSPACE=/workspace
SAVE_CHECKPOINTS=true
MAX_CHECKPOINT_SIZE=10GB

# Provider Configuration
ENABLE_KAGGLE_PROVIDER=true
ENABLE_COLAB_PROVIDER=true
ENABLE_HUGGINGFACE_PROVIDER=true

# Training Configuration
DEFAULT_TRAINING_METHOD=qlora
DEFAULT_BATCH_SIZE=2
DEFAULT_LEARNING_RATE=0.0001
DEFAULT_EPOCHS=3
DEFAULT_MAX_SEQUENCE_LENGTH=2048

# Evaluation Configuration
EVALUATION_MODELS=llama2,codealpaca,qwen
EVALUATION_METRICS=accuracy,f1,bleu,rouge

# Security Settings
REQUIRE_AUTHENTICATION=true
ALLOW_PUBLIC_MODELS=false
DATASET_VALIDATION_REQUIRED=true

# Resource Management
GPU_TIMEOUT_HOURS=24
MAX_MEMORY_USAGE=80%
RETRY_ATTEMPTS=3

# Backup and Recovery
BACKUP_ENABLED=true
BACKUP_PATH=/workspace/backups
CHECKPOINT_RETENTION_DAYS=30